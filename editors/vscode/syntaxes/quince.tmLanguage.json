{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quince",
  "scopeName": "source.quince",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "`##` at the start of a line is documentation and is attached to the declaration below it; `#` anywhere is a comment and is discarded. Listed first so the more specific rule wins.",
          "name": "comment.line.documentation.quince",
          "begin": "^\\s*##",
          "end": "$",
          "patterns": [
            {
              "comment": "The tag set is closed — see `Tag` in src/doc.rs, which `the_editor_grammar_spells_every_documentation_tag` holds this against.",
              "name": "keyword.other.documentation.quince",
              "match": "@(param|return|throws)\\b"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.quince",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quince",
          "match": "\\b(if|else|while|for|in|return|try|catch|throw|import)\\b"
        },
        {
          "comment": "`from` is not reserved: it is a keyword only where the parser treats it as one, which is at the start of a `from <module> import` and nowhere else.",
          "name": "keyword.control.quince",
          "match": "\\bfrom\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s+import\\b)"
        },
        {
          "name": "keyword.declaration.quince",
          "match": "\\b(fn|op|class|extends|extend|let|final|complete|sealed|const|public|private|protected|any|is|alias)\\b"
        },
        {
          "name": "variable.language.quince",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.quince",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.quince",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.quince",
              "match": "\\\\([ntr0\\\\'\"])"
            }
          ]
        },
        {
          "name": "string.quoted.single.quince",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.quince",
              "match": "\\\\([ntr0\\\\'\"])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.quince",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.quince",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn|op)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.quince" },
            "2": { "name": "entity.name.function.quince" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.quince"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.quince",
          "match": "(\\?\\?|\\?\\.|==|!=|<=|>=|<<|>>|//|&&|\\|\\||\\+|-|\\*|/|%|&|\\||\\^|~|=|!|<|>|\\?)"
        }
      ]
    }
  }
}
