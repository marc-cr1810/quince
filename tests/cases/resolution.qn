# Nested functions declared in either order can call each other, because
# declarations are collected before the bodies are resolved.
fn parity(n) {
    fn even(k) {
        if k == 0 { return "even" }
        return odd(k - 1)
    }
    fn odd(k) {
        if k == 0 { return "odd" }
        return even(k - 1)
    }
    return even(n)
}
print(parity(10))
print(parity(7))

# A capture three scopes out.
fn deep() {
    let found = "deep"
    fn a() {
        fn b() {
            fn c() { return found }
            return c()
        }
        return b()
    }
    return a()
}
print(deep())

# Each iteration gets a fresh scope, so the closures do not share one slot.
fn makers() {
    let out = []
    for n in [1, 2, 3] {
        fn hold() { return n }
        push(out, hold)
    }
    return out
}
let held = makers()
print(held[0](), held[1](), held[2]())
