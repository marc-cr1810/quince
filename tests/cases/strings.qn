let name = "world"
print("hello, " + name)
print(len("hello"))
print("abc" < "abd")

# Indexed by character, not by byte, so a multibyte character is one position
# and the subscript agrees with `len`.
let s = "héllo"
print(len(s))
print(s[0], s[1], s[4])
print(s[-1], s[-5])

# Slicing. Either bound may be left out, and both may be negative.
print(s[1:3])
print(s[2:])
print(s[:4])
print(s[-3:])
print(s[:])

# Bounds are clamped rather than checked, so asking for more than exists is not
# an error. An inverted range is empty.
print(s[:100])
print(s[10:20])
print(s[3:1])

# Lists slice the same way, and the result is a new list rather than a view.
let xs = [1, 2, 3, 4, 5]
let part = xs[1:4]
part.push(99)
print(part)
print(xs)
print(xs[-2:])

# Methods.
print("  padded  ".trim())
print("Quince".upper(), "Quince".lower())
print("a,b,c".split(","))
print("-".join(["a", "b", "c"]))
print("banana".replace("na", "NA"))
print("quince".starts_with("qu"), "quince".ends_with("ce"))
print("héllo".chars())

# Chaining, since a method call is just an expression.
print(", ".join("a-b-c".split("-")).upper())
print("héllo".chars()[1])

# A separator that is not present gives the whole string back.
print("abc".split(","))
