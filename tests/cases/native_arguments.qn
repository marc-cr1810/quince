from math import floor, pow, min, max

# A builtin's parameters have declared types now, so a wrong argument is
# refused in the same words a wrong argument to a function you wrote gets.
print(floor(2.7))
# Numeric builtins take either, so nothing is converted on the way in.
print(floor(3))
print(pow(2, 3))
print(min(1, 2.0))
print(max(1.0, 2))

print("a,b".split(","))
print("ab".repeat(3))
print("hello".starts_with("he"))
print("hello".replace("l", "L"))
print(", ".join(["a", "b"]))

# A parameter that names no types admits anything, which is most of them.
let xs = [1, "two", nil]
xs.push(true)
print(len(xs))
print(type(xs))
