import math
from math import pi, sqrt, floor

# Reached through the module, and reached directly. The same function both ways:
# a module hands its names back unbound, so nothing is inserted at either call.
print(math.floor(2.7), floor(2.7))
print(math.ceil(2.1), math.round(2.5), math.round(2.4))

# `abs` answers with the kind it was given; the rounding three always answer with
# an int, because what they are for is indexing and counting.
print(math.abs(-3), math.abs(-3.5))
print(math.min(1, 2), math.max(1.5, 2))
print(sqrt(16.0), math.pow(2, 10))
print(pi)

# A module is a value: it prints, it has a type, and it is equal to itself.
print(math)
print(type(math))
print(math == math)

# An int is accepted wherever a float is, and a payload is unwrapped first, so a
# class extending a builtin can be measured like the number it is.
class Celsius extends float {}
print(math.floor(Celsius(21.7)))

# `from` is not a reserved word. It is an import only at the start of a statement
# with an `import` two tokens along, and an ordinary name everywhere else.
fn span(from, to) { return to - from }
print(span(3, 10))
let from = 5
print(from)
